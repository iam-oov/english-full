# Pronunciation Tetris — configuración.  Copiá este archivo a ".env":
#   cp .env.example .env
# (Los comentarios van SIEMPRE en su propia línea, no al final de un valor.)

# ─────────────────────────  Azure Speech  (REQUERIDO)  ─────────────────────────
# portal.azure.com → Create a resource → "Speech" → Create (free tier F0 = 5 hs/mes).
# Luego: "Keys and Endpoint" → copiá KEY 1 y la Region (en código: eastus, westus2…).
AZURE_SPEECH_KEY=pega-tu-key-aca
AZURE_SPEECH_REGION=eastus

# ──────────────────────────  Juego  (opcional, con defaults)  ──────────────────
# Idioma a evaluar (en-US, en-GB, etc.)
TARGET_LANGUAGE=en-US
# Voz neural para "escuchá la correcta" (tecla F). Azure tiene decenas, gratis.
# Masculinas: en-US-AndrewNeural, en-US-GuyNeural, en-US-BrianNeural, en-GB-RyanNeural.
# Femeninas: en-US-AvaNeural, en-US-JennyNeural, en-US-EmmaNeural, en-GB-SoniaNeural.
TTS_VOICE=en-US-AndrewNeural
# Tono y velocidad de esa voz (Azure, vía SSML). Ej: '-15%' más grave,
# '+15%' más agudo; rate '-10%' más lento. '0%' = normal.
TTS_PITCH=0%
TTS_RATE=0%
# % mínimo en CADA sonido para derrotar un objetivo.
PASS_THRESHOLD=94
# 2da vía: pasás si tu PROMEDIO quedó a ≤N puntos del umbral Y te entendió bien.
NEAR_MISS_MARGIN=5
# Nivel CEFR del alumno (A1..C2): adapta los consejos del coach.
CEFR_LEVEL=B2

# ───────────────────────  DeepSeek / coach con IA  (OPCIONAL)  ─────────────────
# Vacío = pistas estáticas. Con tu key = consejos personalizados al fallar.
# Conseguila en https://platform.deepseek.com (Profile → API Keys).
DEEPSEEK_API_KEY=
# Avanzado (tienen default; descomentá solo si querés cambiarlos):
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
